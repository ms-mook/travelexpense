# =====================================================================
# Frontend (VITE_* หรือ NEXT_PUBLIC_*) — ค่าพวกนี้ถูกฝังใน Browser = เปิดเผยได้เท่านั้น
# ถ้าเชื่อม Supabase ผ่าน Vercel Integration จะได้ NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY มาเอง
# =====================================================================
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=public-anon-key

# =====================================================================
# Backend (Vercel Environment Variables) — SECRET ห้ามขึ้นต้นด้วย VITE_
# =====================================================================
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-keep-secret

# Google Service Account (ใช้ทั้ง Sheets และ Drive)
GOOGLE_SERVICE_ACCOUNT_EMAIL=travel-expense@your-project.iam.gserviceaccount.com
# ใส่ทั้งก้อนในบรรทัดเดียว โดยใช้ \n แทนการขึ้นบรรทัด
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ID ของ Spreadsheet TRAVEL_EXPENSE_DATABASE (แชร์ให้ Service Account เป็น Editor เท่านั้น)
GOOGLE_SHEETS_ID=1AbCdEf...
# โฟลเดอร์ใบเสร็จ — ต้องอยู่ใน Shared Drive (Service Account ไม่มีโควตาพื้นที่ใน My Drive)
GOOGLE_DRIVE_RECEIPT_FOLDER_ID=0AbCdEf...

# (ไม่บังคับ) คำนวณระยะทางอ้างอิงจาก Google Maps — เปิด "Routes API" ใน Google Cloud แล้วจำกัด key ให้ใช้ได้เฉพาะ Routes API
GOOGLE_MAPS_API_KEY=

# เปิดระบบแนบใบเสร็จ (ตั้งเป็น true เมื่อพร้อมที่เก็บไฟล์แล้ว)
RECEIPTS_ENABLED=false

# CORS: โดเมนที่อนุญาต (คั่นด้วย ,) — ถ้า Frontend อยู่โดเมนเดียวกันไม่ต้องตั้ง
ALLOWED_ORIGINS=

# ใช้เฉพาะ scripts/seed-admin.js ตอนติดตั้งครั้งแรก
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=System Admin
